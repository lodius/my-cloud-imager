[Unit]
Description=Lumen private photo library
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lumen
Group=lumen
WorkingDirectory=/opt/lumen
EnvironmentFile=/etc/lumen/lumen.env
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
